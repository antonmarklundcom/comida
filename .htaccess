# comida.com.py — Hostinger (Apache/LiteSpeed)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS and apex domain (www -> comida.com.py)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(comida\.com\.py)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# asado.com.py -> comida.com.py/asado/ (plan/10 §11). Enable only once asado.com.py DNS points
# to this hosting and /asado/ is published; until then it must stay commented out.
# RewriteCond %{HTTP_HOST} ^(?:www\.)?asado\.com\.py$ [NC]
# RewriteRule ^(.*)$ https://comida.com.py/asado/$1 [R=301,L]

# Block dotfiles and anything that is not the one public PHP handler.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteCond %{REQUEST_URI} \.php$ [NC]
RewriteCond %{REQUEST_URI} !^/php/(lead-forward|feedback)\.php$ [NC]
RewriteRule ^ - [F,L]

# Clean URLs: /catering/bodas -> /catering/bodas/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(avif|webp|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>

<IfModule mod_mime.c>
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
